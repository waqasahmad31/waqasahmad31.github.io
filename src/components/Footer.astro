---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap-wide inner">
    <div class="cols">
      <div>
        <p class="ftitle">{profile.name}</p>
        <p class="muted small">
          {profile.title} · {profile.subtitle}<br />
          {profile.location} ({profile.timezone})
        </p>
        <p class="muted small avail">{profile.availability}</p>
      </div>

      <div>
        <p class="ftitle">Contact</p>
        <ul class="list">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.phoneHref}>{profile.phone}</a></li>
          <li><a href={profile.linkedin} rel="noopener">{profile.linkedinLabel}</a></li>
          <li><a href={profile.github} rel="noopener">{profile.githubLabel}</a></li>
        </ul>
      </div>

      <div>
        <p class="ftitle">Pages</p>
        <ul class="list">
          <li><a href="/">Home</a></li>
          <li><a href="/work/">All work</a></li>
          <li><a href="/about/">About &amp; full CV</a></li>
        </ul>
      </div>
    </div>

    <p class="year muted">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); margin-top: var(--section-gap); background: var(--color-bg-tint); }
  .inner { padding-top: 44px; padding-bottom: 46px; }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 34px;
  }
  .ftitle { font-weight: 620; font-size: 14.5px; margin-bottom: 9px; }
  .small { font-size: 14px; }
  .avail { margin-top: 10px; }
  .list { list-style: none; margin: 0; padding: 0; font-size: 14px; }
  .list li { margin-bottom: 6px; }
  .year {
    margin-top: 34px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-text-faint);
  }

  @media (max-width: 720px) {
    .cols { grid-template-columns: 1fr 1fr; gap: 28px; }
    .cols > :first-child { grid-column: 1 / -1; }
  }
</style>
