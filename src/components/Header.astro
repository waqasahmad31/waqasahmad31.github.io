---
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="wrap-wide bar">
    <a href="/" class="brand" aria-label="Waqas Ahmad — home">
      <span class="mark" aria-hidden="true">WA</span>
      <span class="brand-text">
        <span class="name">Waqas Ahmad</span>
        <span class="role">.NET &amp; Angular · Tech Lead</span>
      </span>
    </a>

    <nav aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]}>{l.label}</a>
      ))}
      <a href="https://github.com/waqasahmad31" class="nav-link ext" rel="noopener">GitHub</a>
      <a href="mailto:iamwaqas31@gmail.com" class="cta">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 66px;
  }

  .brand { display: inline-flex; align-items: center; gap: 11px; color: var(--color-text); }
  .brand:hover { text-decoration: none; }
  .mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.25; }
  .name { font-weight: 640; font-size: 15.5px; letter-spacing: -0.01em; }
  .role { font-size: 11.5px; color: var(--color-text-faint); }

  nav { display: flex; align-items: center; gap: 6px; font-size: 14.5px; }
  .nav-link {
    color: var(--color-text-muted);
    padding: 7px 12px;
    border-radius: 999px;
    font-weight: 500;
  }
  .nav-link:hover {
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface-2);
  }
  .nav-link.active { color: var(--color-text); background: var(--color-surface-2); }
  .cta {
    margin-left: 6px;
    padding: 7px 16px;
    border-radius: 999px;
    font-weight: 550;
    color: var(--color-on-accent);
    background: var(--color-accent);
  }
  .cta:hover { text-decoration: none; background: var(--color-accent-hover); }

  @media (max-width: 720px) {
    .role { display: none; }
    nav { gap: 2px; font-size: 14px; }
    .nav-link { padding: 7px 9px; }
  }
  @media (max-width: 520px) {
    .name { display: none; }
    .nav-link.ext { display: none; }
  }
</style>
