---
import Layout from '../layouts/Layout.astro';
import {
  profile,
  impact,
  skillGroups,
  experience,
  featuredProjects,
  allProjects,
} from '../data/profile';

const otherProjectCount = allProjects.length - featuredProjects.length;

const domains = [
  'Government identity',
  'ERP',
  'Healthcare & telehealth',
  'Streaming',
  'E-learning',
  'Recruitment',
  'Risk & compliance',
  'Legal tech',
  'Travel',
  'E-commerce',
  'Web3',
  'Supply chain',
];

const highlightSkills = skillGroups.filter((g) => g.label !== 'Also worked with');
---

<Layout
  title="Senior .NET & Angular Engineer"
  description="Waqas Ahmad — senior full-stack .NET and Angular developer and technical team lead in Islamabad, Pakistan. Case studies from national-scale identity systems, ERP architecture and clinical platforms. Open to remote, onsite and relocation."
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap-wide hero-inner">
      <p class="status">
        <span class="dot" aria-hidden="true"></span>
        Open to senior, lead &amp; architect roles — remote, onsite or relocation
      </p>

      <h1>I build and lead production systems end&#8209;to&#8209;end.</h1>

      <p class="lede">
        {profile.title} and technical lead for a team of eight, currently delivering a national-scale
        biometric identity platform. Six years shipping web and desktop products for clients across
        the <strong>UK, the Gulf and government</strong> — from database schema through UI, and from
        CI/CD through production support.
      </p>

      <div class="actions">
        <a class="btn primary" href="/work/">See all work</a>
        <a class="btn" href="/about/">About &amp; full CV</a>
        <a class="btn" href={`mailto:${profile.email}`}>Get in touch</a>
      </div>

      <dl class="quickfacts">
        <div><dt>Based in</dt><dd>{profile.location} ({profile.timezone})</dd></div>
        <div><dt>Currently</dt><dd>Tech lead, Techostudios</dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
        <div><dt>Phone</dt><dd><a href={profile.phoneHref}>{profile.phone}</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="impact-band">
    <div class="wrap-wide">
      <div class="impact-grid">
        {impact.map((i) => (
          <div class="stat">
            <div class="figure">{i.figure}</div>
            <p class="muted">{i.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap-wide">
      <p class="kicker">Selected work</p>
      <h2>Three systems, and the decisions behind them</h2>
      <p class="section-note muted">
        Most of what I build is private or client-owned, so these are written as case studies rather
        than repositories — the problem, the trade-offs, and what actually changed. Another
        {otherProjectCount} projects are described on the <a href="/work/">work page</a>.
      </p>

      <div class="cases">
        {featuredProjects.map((c) => (
          <a class="case" href={c.slug}>
            <p class="case-kicker">{c.domain} · {c.period}</p>
            <h3>{c.name}</h3>
            <p class="muted">{c.summary}</p>
            <div class="tags">
              {c.stack.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
            </div>
            <span class="more">Read the case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap-wide">
      <p class="kicker">Capability</p>
      <h2>What I work with</h2>
      <div class="skills">
        {highlightSkills.map((g) => (
          <div class="skill-group">
            <h3>{g.label}</h3>
            <div class="tags">
              {g.items.map((s) => <span class="tag">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
      <p class="note muted">
        Full skill list, including legacy stacks, on the <a href="/about/">about page</a>.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap-wide">
      <p class="kicker">Range</p>
      <h2>Domains I have shipped into</h2>
      <p class="section-note muted">
        Twelve industries in six years. Breadth is not the point on its own — it means I have had to
        learn a business quickly and often, which is most of what delivery work actually is.
      </p>
      <div class="tags domains">
        {domains.map((d) => <span class="tag">{d}</span>)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap-wide">
      <p class="kicker">Experience</p>
      <h2>Where I have done it</h2>
      <ol class="timeline">
        {experience.map((r) => (
          <li>
            <p class="period">{r.period}</p>
            <h3>{r.title}</h3>
            <p class="org">{r.org}</p>
            {r.context && <p class="context muted">{r.context}</p>}
          </li>
        ))}
      </ol>
      <p class="note muted">
        Full responsibilities and outcomes for each role on the
        <a href="/about/">about page</a>.
      </p>
    </div>
  </section>

  <section class="block contact-cta">
    <div class="wrap-wide panel">
      <p class="kicker">Contact</p>
      <h2>Open to senior, lead and architect roles</h2>
      <p class="muted">
        Remote, onsite or relocation — contract or full-time. The fastest way to reach me is email,
        and I am happy to walk through the architecture behind any of this work in a conversation.
      </p>
      <div class="actions">
        <a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn" href={profile.phoneHref}>{profile.phone}</a>
        <a class="btn" href={profile.linkedin} rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { position: relative; padding: 76px 0 58px; overflow: hidden; }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(760px 340px at 12% -8%, var(--color-accent-soft), transparent 70%),
      linear-gradient(180deg, var(--color-bg-tint), transparent 55%);
    pointer-events: none;
  }
  .hero-inner { position: relative; }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 6px 15px 6px 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: 999px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.18);
    flex: none;
  }

  h1 { font-size: clamp(34px, 6vw, 60px); max-width: 16ch; margin-top: 26px; }
  .lede {
    margin-top: 24px;
    max-width: 64ch;
    font-size: 18px;
    color: var(--color-text-muted);
  }
  .lede strong { color: var(--color-text); font-weight: 600; }

  .actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 32px; }

  .quickfacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px 28px;
    margin: 44px 0 0;
    padding-top: 26px;
    border-top: 1px solid var(--color-border);
  }
  .quickfacts dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .quickfacts dd { margin: 5px 0 0; font-size: 14.5px; }

  .impact-band { padding: 8px 0 0; }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 26px 34px;
    padding: 34px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .figure { font-size: 29px; font-weight: 680; letter-spacing: -0.035em; color: var(--color-accent); }
  .stat p { font-size: 14.5px; margin-top: 7px; }

  .block { padding-top: var(--section-gap); }
  .block h2 { font-size: clamp(24px, 3.4vw, 33px); margin-bottom: 15px; }
  .section-note { max-width: 62ch; font-size: 16px; }
  .note { font-size: 14.5px; margin-top: 22px; }

  .cases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 18px;
    margin-top: 34px;
  }
  .case {
    display: flex;
    flex-direction: column;
    padding: 26px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
    transition: border-color 0.16s ease, transform 0.16s ease, box-shadow 0.16s ease;
  }
  .case:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }
  .case-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .case h3 { font-size: 19px; margin: 11px 0 10px; }
  .case p.muted { font-size: 15px; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 17px; }
  .more { display: inline-block; margin-top: 18px; font-size: 14.5px; color: var(--color-accent); font-weight: 500; }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 26px 38px;
    margin-top: 32px;
  }
  .skill-group h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-faint); font-family: var(--font-mono); font-weight: 600; }
  .skill-group .tags { margin-top: 11px; }

  .domains { margin-top: 26px; }
  .domains .tag { font-family: var(--font-sans); font-size: 13.5px; padding: 6px 13px; }

  .timeline { list-style: none; margin: 32px 0 0; padding: 0; }
  .timeline > li {
    padding: 0 0 26px 24px;
    border-left: 2px solid var(--color-border);
    position: relative;
  }
  .timeline > li:last-child { padding-bottom: 0; }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .period { font-family: var(--font-mono); font-size: 12.5px; color: var(--color-text-faint); }
  .timeline h3 { font-size: 18px; margin: 7px 0 3px; }
  .org { font-size: 15px; color: var(--color-accent); }
  .context { font-size: 14px; margin-top: 3px; }

  .contact-cta .panel {
    padding: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background:
      radial-gradient(600px 240px at 88% 0%, var(--color-accent-soft), transparent 70%),
      var(--color-surface);
  }
  .contact-cta h2 { max-width: 22ch; }
  .contact-cta p { max-width: 58ch; font-size: 16px; }

  @media (max-width: 640px) {
    .hero { padding: 52px 0 40px; }
    .contact-cta .panel { padding: 28px 22px; }
  }
</style>
